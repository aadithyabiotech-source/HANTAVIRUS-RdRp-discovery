def calculate_sa_score(mol):
    if mol is None: return 10.0
    return round(Descriptors.MolWt(mol) / 100 + rdMolDescriptors.CalcNumRings(mol) + len(Chem.FindMolChiralCenters(mol)), 2)

def generate_baloxavir_library(n_target=600):
    # Template: Dibenzothiepin core with placeholder for Sidechain (SC) and R-group (RG)
    template = "S1Cc2ccccc2[C@H]({SC})c3cc({RG})ccc31"

    sidechains = [
        "N1CCN(C(=O)c2cc(=O)ccn2)CC1", "N1CCOC[C@@H]1n2ccc(=O)cc2=O",
        "N1CCN(S(=O)(=O)C)CC1", "N1CCN(Cc2ccccc2)CC1",
        "N1CCN(C(=O)C2CC2)CC1", "N1CCOCC1", "N1CCN(C)CC1",
        "N1CCN(CC(F)(F)F)CC1", "N1CCN(C(=O)OC(C)(C)C)CC1",
        "N1CC(F)(F)C1", "N1CCC(F)(F)CC1", "N1CCN(C2CC2)CC1",
        "N1CCN(C(=O)Nc2ccccc2)CC1", "N1CC2(CN(C)C2)CC1",
        "N1CCCCC1", "N1CCN(S(=O)(=O)N(C)C)CC1", "N1CCN(CC2CC2)CC1",
        "N1CC(F)C1", "N1CCN(C(=O)C)CC1", "N1CC[NH+](C)CC1",
        "N1CCCC[C@H]1C", "N1CC[C@@H](F)C1", "N1CCN(C(=O)C2=CC=CC=C2)CC1"
    ]

    r_groups = [
        "F", "Cl", "Br", "I", "C", "CC", "CCC", "OC", "N", "C#N",
        "C(F)(F)F", "OC(F)(F)F", "C1CC1", "NC(=O)C", "SC", "C#C",
        "C=C", "C(=O)C", "C(=O)OC", "N(C)C", "O", "S(=O)(=O)C",
        "c1ccccc1", "n1cccc1", "OC1CC1", "S(O)(=O)C", "C(=O)N(C)C", "NC(=O)N", "C(F)F"
    ]

    results = []
    seen_smiles = set()

    for sc in sidechains:
        for rg in r_groups:
            try:
                smi_candidate = template.format(SC=sc, RG=rg)
                mol = Chem.MolFromSmiles(smi_candidate)
                if mol:
                    if Chem.SanitizeMol(mol, catchErrors=True) == 0:
                        can_smi = Chem.MolToSmiles(mol, isomericSmiles=True)
                        if can_smi not in seen_smiles:
                            results.append({
                                'SMILES': can_smi,
                                'QED': round(Descriptors.qed(mol), 3),
                                'LogP': round(Descriptors.MolLogP(mol), 2),
                                'MW': round(Descriptors.MolWt(mol), 1),
                                'SA_Score': calculate_sa_score(mol)
                            })
                            seen_smiles.add(can_smi)
                if len(results) >= n_target: break
            except: continue
        if len(results) >= n_target: break

    return pd.DataFrame(results)

# Run library generation and save without heavy prints to avoid UnicodeEncodeError
library_df = generate_baloxavir_library(600)

if not library_df.empty:
    library_df = library_df.sort_values('QED', ascending=False)
    library_df.to_csv('baloxavir_novel_library_v11.csv', index=False)
    print(f'✅ Successfully generated and saved {len(library_df)} unique novel analogs to baloxavir_novel_library_v11.csv')
else:
    print('❌ Library generation failed.')

