import numpy as np
import os

def load_pdbqt_coords(filepath):
    atoms = []
    if not os.path.exists(filepath):
        return None
    with open(filepath, 'r') as f:
        for line in f:
            if line.startswith(("ATOM", "HETATM")):
                try:
                    x = float(line[30:38])
                    y = float(line[38:46])
                    z = float(line[46:54])
                    res_name = line[17:20].strip()
                    res_num = line[22:26].strip()
                    chain = line[21].strip()
                    atom_name = line[12:16].strip()
                    atoms.append({
                        'coord': np.array([x, y, z]),
                        'res_name': res_name,
                        'res_num': res_num,
                        'chain': chain,
                        'atom_name': atom_name
                    })
                except ValueError:
                    continue
    return atoms

# Load receptor and redocked ligand
receptor_atoms = load_pdbqt_coords('1SA0_receptor (2).pdbqt')
ligand_atoms = load_pdbqt_coords('colchicine_redock_out.pdbqt')

if receptor_atoms and ligand_atoms:
    pocket_residues = {}
    # Check all pairwise distances between ligand and receptor atoms
    for l_atom in ligand_atoms:
        for r_atom in receptor_atoms:
            dist = np.linalg.norm(l_atom['coord'] - r_atom['coord'])
            if dist < 4.5: # 4.5 Angstroms threshold for non-bonded interactions
                res_key = f"{r_atom['res_name']}_{r_atom['res_num']}_{r_atom['chain']}"
                if res_key not in pocket_residues:
                    pocket_residues[res_key] = dist
                else:
                    pocket_residues[res_key] = min(pocket_residues[res_key], dist)

    print("--- Identified Binding Pocket Residues (within 4.5Å of Colchicine) ---")
    # Sort by closest distance
    sorted_residues = sorted(pocket_residues.items(), key=lambda x: x[1])
    for res, d in sorted_residues[:20]:
        print(f"Residue: {res:<15} | Min Distance: {d:.2f} Å")
else:
    print("❌ Error loading coordinates. Please verify file paths.")  



