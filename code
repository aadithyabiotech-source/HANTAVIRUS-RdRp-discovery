import os
import pandas as pd
from rdkit import Chem
from rdkit.Chem import AllChem, DataStructs
from rdkit.Chem.Scaffolds import MurckoScaffold

# 1. Load the pre-generated library
csv_path = 'baloxavir_novel_library_v11.csv'
if not os.path.exists(csv_path):
    # Re-generate fallback library if missing
    from rdkit.Chem import Descriptors, rdMolDescriptors
    def generate_baloxavir_library(n_target=600):
        template = "S1Cc2ccccc2[C@H]({SC})c3cc({RG})ccc31"
        sidechains = ["N1CCN(C(=O)c2cc(=O)ccn2)CC1", "N1CCOC[C@@H]1n2ccc(=O)cc2=O", "N1CCN(S(=O)(=O)C)CC1", "N1CCN(Cc2ccccc2)CC1"]
        r_groups = ["F", "Cl", "Br", "I", "C", "CC", "CCC", "OC", "N", "C#N", "C(F)(F)F", "OC(F)(F)F"]
        results = []
        seen = set()
        for sc in sidechains:
            for rg in r_groups:
                smi = template.format(SC=sc, RG=rg)
                mol = Chem.MolFromSmiles(smi)
                if mol and Chem.SanitizeMol(mol, catchErrors=True) == 0:
                    can = Chem.MolToSmiles(mol, isomericSmiles=True)
                    if can not in seen:
                        results.append({'SMILES': can, 'QED': Descriptors.qed(mol), 'LogP': Descriptors.MolLogP(mol), 'MW': Descriptors.MolWt(mol)})
                        seen.add(can)
        return pd.DataFrame(results)
    df_lib = generate_baloxavir_library(600)
    df_lib.to_csv(csv_path, index=False)
else:
    df_lib = pd.read_csv(csv_path)

# 2. Reference structures
balox_mol = Chem.MolFromSmiles("O=C1c2cc(=O)ccn2N([C@H]2c3ccccc3CSc3ccccc32)[C@@H]2COCCN12")
balox_scaffold = MurckoScaffold.GetScaffoldForMol(balox_mol)
balox_scaffold_smi = Chem.MolToSmiles(balox_scaffold, isomericSmiles=True)

# 3. Analyze library scaffolds
scaffolds = []
similarities = []
fp_ref = AllChem.GetMorganFingerprintAsBitVect(balox_mol, 2, nBits=2048)

for idx, row in df_lib.iterrows():
    mol = Chem.MolFromSmiles(row['SMILES'])
    if mol:
        scaf = MurckoScaffold.GetScaffoldForMol(mol)
        scaffolds.append(Chem.MolToSmiles(scaf, isomericSmiles=True))
        fp = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=2048)
        similarities.append(DataStructs.TanimotoSimilarity(fp_ref, fp))
    else:
        scaffolds.append(None)
        similarities.append(0.0)

df_lib['Bemis_Murcko_Scaffold'] = scaffolds
df_lib['Tanimoto_Similarity'] = similarities

# Count scaffold occurrences
same_scaffold = df_lib[df_lib['Bemis_Murcko_Scaffold'] == balox_scaffold_smi]
diff_scaffold = df_lib[df_lib['Bemis_Murcko_Scaffold'] != balox_scaffold_smi]

print("=== SCAFFOLD NOVELTY SUMMARY ===")
print(f"Total Molecules Analyzed: {len(df_lib)}")
print(f"Molecules Sharing Original Scaffold: {len(same_scaffold)}")
print(f"Molecules with Scaffold Hop Core: {len(diff_scaffold)}")

# Filter True Scaffold Hops (Tanimoto < 0.4)
true_hops = diff_scaffold[diff_scaffold['Tanimoto_Similarity'] < 0.4].sort_values('QED', ascending=False).head(10)
print(f"Isolated {len(true_hops)} True Scaffold-Hopped Candidates for Docking Validation.")
display(true_hops)
